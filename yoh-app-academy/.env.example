# Canonical origin, including the port in local development.
# Vercel Production: https://yo-app-academy.vercel.app
YOH_APP_URL=http://localhost:3002
# Local/Node/Docker storage only; not persistent storage on Vercel.
# Relative paths resolve from yoh-app-academy/.
YOH_DATA_DIR=.data
# Reuse the existing private invitation in the app runtime and Convex deployment.
YOH_MENTOR_INVITE=
# Public contact address, embedded at build time; rebuild after changing it.
NEXT_PUBLIC_CONTACT_EMAIL=yohansforex@gmail.com
# One-time admin bootstrap for a new setup. Reuse the existing production admin.
# Run pnpm setup-admin when needed, then remove the bootstrap password.
YOH_ADMIN_EMAIL=
YOH_ADMIN_NAME=
YOH_ADMIN_PASSWORD=
# Optional isolated Next.js output directory for development or CI.
# Leave unset on Vercel.
# YOH_BUILD_DIR=.next

# Leave URLs empty for local SQLite development.
# Vercel Production requires both URLs set to the SAME existing Convex production URL.
CONVEX_URL=
# The deployment URL is public; never put a private key in this variable.
NEXT_PUBLIC_CONVEX_URL=
# Reuse the matching private server-only secret in Next.js and Convex environment.
YOH_CONVEX_SERVER_SECRET=
# Vercel builds with Node 24 and Corepack/pnpm; set this in its build environment.
# ENABLE_EXPERIMENTAL_COREPACK=1
# Backend changes deploy separately through the authenticated local Convex CLI.
# No CONVEX_DEPLOY_KEY or Convex account token is required/granted to Vercel.
