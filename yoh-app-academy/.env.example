# Canonical origin, including port in local development.
YOH_APP_URL=http://localhost:3002
# Persistent directory. Relative paths resolve from yoh-app-academy/.
YOH_DATA_DIR=.data
# Match this private invitation in the app runtime and Convex deployment.
YOH_MENTOR_INVITE=
# Optional public company contact address, embedded at build time.
NEXT_PUBLIC_CONTACT_EMAIL=
# One-time admin bootstrap. Run pnpm setup-admin, then remove the password.
YOH_ADMIN_EMAIL=
YOH_ADMIN_NAME=
YOH_ADMIN_PASSWORD=
# Optional isolated Next.js output directory for development or CI.
# YOH_BUILD_DIR=.next

# Convex: leave URLs empty for local SQLite development.
# Netlify Free manual deployment: set both to the same production URL.
CONVEX_URL=
# The deployment URL is public; never put a private key in this variable.
NEXT_PUBLIC_CONVEX_URL=
# Match this private server-only secret in Next.js and Convex deployment env.
YOH_CONVEX_SERVER_SECRET=
# Manual local backend deployment and frontend artifact upload need no deploy key.
# Keep authenticated Convex CLI/account credentials on this computer.
