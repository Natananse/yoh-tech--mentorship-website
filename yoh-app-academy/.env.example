# Canonical origin, including port in local development.
YOH_APP_URL=http://localhost:3002
# Persistent directory. Relative paths resolve from yoh-app-academy/.
YOH_DATA_DIR=.data
# Use a long private invitation code to enable mentor registration.
YOH_MENTOR_INVITE=
# Optional public company contact address, embedded at build time.
NEXT_PUBLIC_CONTACT_EMAIL=
# One-time admin bootstrap. Run pnpm setup-admin, then remove the password.
YOH_ADMIN_EMAIL=
YOH_ADMIN_NAME=
YOH_ADMIN_PASSWORD=
# Optional isolated Next.js output directory for development or CI.
# YOH_BUILD_DIR=.next

# Convex: leave URL empty for local SQLite development. Required on Vercel.
CONVEX_URL=
# The CLI may set NEXT_PUBLIC_CONVEX_URL instead; the deployment URL is public.
NEXT_PUBLIC_CONVEX_URL=
# Match this private server-only secret in Next.js and Convex deployment env.
YOH_CONVEX_SERVER_SECRET=
# CI deploy key: configure privately in Vercel, never commit a real value.
CONVEX_DEPLOY_KEY=
